# ─────────────────────────────────────────────────────────────
# CoolTrips — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cooltrips"

# Public contact details
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."

# ─── SerpAPI Google Flights ──────────────────────────────────
# 1. Sign up free at https://serpapi.com/
# 2. Copy your API key (free tier: 100 searches/month)
# 3. Without this key, the app will show "flights not available" message
#
SERPAPI_API_KEY=""

# ─── EmailJS (contact/visa/booking forms) ─────────────────────
# Sign up at https://www.emailjs.com/ and create a service + templates
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_VISA=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_BOOKING=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
