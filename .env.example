# ─────────────────────────────────────────────────────────────
# CoolTrips — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# Database (Prisma + PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/cooltrips"

# Public contact details
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."

# ─── Amadeus Flight Search API ────────────────────────────────
# 1. Sign up free at https://developers.amadeus.com/
# 2. Create an app → copy Client ID & Secret below
# 3. Test environment is free with realistic sample data
# 4. For live production data, verify your account & set AMADEUS_ENV=production
#
# When AMADEUS_CLIENT_ID is empty, the app falls back to mock data automatically.

AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
# Options: "test" (default, free) | "production" (requires verified account)
AMADEUS_ENV="test"

# ─── Other integrations (future) ─────────────────────────────
TRAVELPAYOUTS_TOKEN=""
